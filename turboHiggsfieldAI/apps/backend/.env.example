# Database Connection (Unpooled for Prisma 8 Driver Adapter)
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/higgsfield_db"

# JWT Authentication
JWT_SECRET="super-secret-access-token-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-prod"

# Moderation API
OPENAI_API_KEY="sk-..."

# Model APIs
GOOGLE_GENAI_API_KEY="AIzaSy..."
OPENROUTER_API_KEY="sk-or-v1-..."

# AWS S3 Storage
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="secret..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="higgsfield-assets-bucket"

# BullMQ Queue (Redis)
REDIS_URL="redis://localhost:6379"

# CORS & Server Config
FRONTEND_URL="http://localhost:5173"
PORT=3000
